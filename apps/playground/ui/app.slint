import { Slider, Button, VerticalBox, HorizontalBox } from "std-widgets.slint";

// Playground do Crita: canvas mínimo pra sentir o brush engine.
// O núcleo pinta num buffer CPU; a UI só mostra a textura e repassa input.
export component AppWindow inherits Window {
    title: "crita playground";
    preferred-width: 1280px;
    preferred-height: 800px;

    in property <image> canvas-image;
    in-out property <float> brush-size: 24;
    in-out property <float> brush-hardness: 80;
    in-out property <float> brush-opacity: 100;
    in-out property <float> brush-spacing: 15;
    in-out property <string> brush-color: "#14141a";
    in-out property <string> stats: "pinte com o mouse";

    callback pointer-down(float, float, float, float);
    callback pointer-move(float, float, float, float);
    callback pointer-up();
    callback clear();
    callback undo();

    HorizontalBox {
        padding: 0px;
        spacing: 0px;

        Image {
            source: root.canvas-image;
            image-fit: fill;

            TouchArea {
                width: 100%;
                height: 100%;

                pointer-event(e) => {
                    if (e.kind == PointerEventKind.down) {
                        root.pointer-down(self.mouse-x / 1px, self.mouse-y / 1px, self.width / 1px, self.height / 1px);
                    } else if (e.kind == PointerEventKind.up || e.kind == PointerEventKind.cancel) {
                        root.pointer-up();
                    }
                }
                moved => {
                    root.pointer-move(self.mouse-x / 1px, self.mouse-y / 1px, self.width / 1px, self.height / 1px);
                }
            }
        }

        Rectangle {
            width: 230px;
            background: #1b1b21;

            VerticalBox {
                padding: 14px;
                spacing: 10px;

                Text { text: "crita playground"; font-size: 15px; color: #e8e8ec; }
                Text { text: "tamanho " + round(root.brush-size); color: #9a9aa4; font-size: 12px; }
                Slider { minimum: 2; maximum: 120; value <=> root.brush-size; }

                Text { text: "dureza " + round(root.brush-hardness) + "%"; color: #9a9aa4; font-size: 12px; }
                Slider { minimum: 0; maximum: 100; value <=> root.brush-hardness; }

                Text { text: "opacidade " + round(root.brush-opacity) + "%"; color: #9a9aa4; font-size: 12px; }
                Slider { minimum: 1; maximum: 100; value <=> root.brush-opacity; }

                Text { text: "espaçamento " + round(root.brush-spacing) + "%"; color: #9a9aa4; font-size: 12px; }
                Slider { minimum: 2; maximum: 100; value <=> root.brush-spacing; }

                HorizontalBox {
                    spacing: 8px;
                    Rectangle { height: 26px; border-radius: 6px; background: #14141a;
                        TouchArea { clicked => { root.brush-color = "#14141a"; } } }
                    Rectangle { height: 26px; border-radius: 6px; background: #c0392b;
                        TouchArea { clicked => { root.brush-color = "#c0392b"; } } }
                    Rectangle { height: 26px; border-radius: 6px; background: #2b50c0;
                        TouchArea { clicked => { root.brush-color = "#2b50c0"; } } }
                    Rectangle { height: 26px; border-radius: 6px; background: #1e8a4c;
                        TouchArea { clicked => { root.brush-color = "#1e8a4c"; } } }
                    Rectangle { height: 26px; border-radius: 6px; background: #e67e22;
                        TouchArea { clicked => { root.brush-color = "#e67e22"; } } }
                }

                HorizontalBox {
                    spacing: 8px;
                    Button { text: "desfazer"; clicked => { root.undo(); } }
                    Button { text: "limpar"; clicked => { root.clear(); } }
                }

                Text { text: root.stats; color: #7a7a84; font-size: 11px; wrap: word-wrap; }
            }
        }
    }
}
